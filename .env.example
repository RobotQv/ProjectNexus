# 复制为 .env；启动前用 python -c "import secrets; print(secrets.token_hex(32))" 生成密钥。
NEXUS_ENVIRONMENT=development
NEXUS_DATABASE_URL=sqlite:///./data/nexus.db
NEXUS_STORAGE_DIR=./data/files
NEXUS_JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
NEXUS_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
NEXUS_TOKEN_MINUTES=120
NEXUS_MAX_UPLOAD_MB=20

# disabled：算法接口未接入时明确报告不可用；demo：仅用于前后端联调，不是正式 AI。
NEXUS_MODULE_MODE=disabled
# 每个人只改自己电脑的配置。非空 MODULE_FACTORY 优先于 demo。
# NEXUS_MODULE_FACTORY=team_modules.factory:build_modules
# NEXUS_MODULE_FACTORY=

# disabled / glm；不填密钥仍可以运行所有普通业务接口。
NEXUS_LLM_MODE=disabled
NEXUS_LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
NEXUS_LLM_MODEL=glm-4.7-flash
NEXUS_LLM_API_KEY=
NEXUS_LLM_TIMEOUT_SECONDS=60
NEXUS_LLM_MAX_CONCURRENCY=2

# Alpha：思考参数按模型能力发送；非智谱兼容接口 auto 默认不发送专用扩展。
NEXUS_LLM_THINKING=auto
NEXUS_LLM_REASONING_EFFORT=low
# 更换切块策略须 python -m app.alpha_cli reindex；旧索引保留供回退。
NEXUS_RAG_RETRIEVAL_MODE=hybrid_rrf
NEXUS_RAG_CHUNK_STRATEGY=bounded
NEXUS_RAG_CANDIDATE_LIMIT=20
# 单地址演示时启用；普通前后端分开开发可以不设置。
# NEXUS_WEB_DIST_DIR=frontend/web/dist
